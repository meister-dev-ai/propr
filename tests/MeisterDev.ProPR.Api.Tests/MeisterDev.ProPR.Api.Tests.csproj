<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.ProPR.TestSupport\MeisterDev.ProPR.TestSupport.csproj"/>
        <ProjectReference Include="..\..\src\MeisterDev.ProPR.CodeInsights\MeisterDev.ProPR.CodeInsights.csproj"/>
        <ProjectReference Include="..\..\src\MeisterDev.ProPR.CodeInsights.Contracts\MeisterDev.ProPR.CodeInsights.Contracts.csproj"/>
        <PackageReference Include="coverlet.collector" Version="8.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7"/>
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0"/>
        <PackageReference Include="NSubstitute" Version="5.3.0"/>
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="Xunit.SkippableFact" Version="1.4.13"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\MeisterDev.ProPR.Api\MeisterDev.ProPR.Api.csproj"/>
        <ProjectReference Include="..\..\src\MeisterDev.ProPR.ProCursor\MeisterDev.ProPR.ProCursor.csproj"/>
        <!--
            Referenced only so it is built before these tests run. The composed host loads it from a directory
            rather than from a reference, which is the whole point of the add-in path.
        -->
        <ProjectReference Include="..\MeisterDev.Ai.Providers.ExampleAddIn\MeisterDev.Ai.Providers.ExampleAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
        Stages the example add-in's own build output as a folder these tests can point the composed host at. Its
        build output is the shape a deployment holds: the add-in's assembly and its dependencies, and none of
        the assemblies the host and an add-in share.
    -->
    <Target Name="StageProviderAddInsForTests" AfterTargets="Build">
        <ItemGroup>
            <_ExampleAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.ExampleAddIn\bin\$(Configuration)\$(TargetFramework)\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(_ExampleAddInFile)"
              DestinationFolder="$(OutDir)add-in-builds\MeisterDev.Ai.Providers.ExampleAddIn"
              SkipUnchangedFiles="true"/>
    </Target>

    <!--
        The families this build ships as add-ins, put where the composed host reads them from. The built-in
        directory sits beside the application's own assemblies, which under a test run is this project's output,
        so a host composed here serves each of them the same way a deployed one does.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.GoogleVertexAddIn\MeisterDev.Ai.Providers.GoogleVertexAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.AzureOpenAiAddIn\MeisterDev.Ai.Providers.AzureOpenAiAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.BedrockAddIn\MeisterDev.Ai.Providers.BedrockAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.LiteLlmAddIn\MeisterDev.Ai.Providers.LiteLlmAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.OpenAiAddIn\MeisterDev.Ai.Providers.OpenAiAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.AnthropicAddIn\MeisterDev.Ai.Providers.AnthropicAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <Target Name="StageBuiltInProviderAddInsForTests" AfterTargets="Build">
        <ItemGroup>
            <_GoogleVertexAddInFile Include="$(MSBuildThisFileDirectory)..\..\src\MeisterDev.Ai.Providers.GoogleVertexAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_OpenAiCompatibleAddInFile Include="$(MSBuildThisFileDirectory)..\..\src\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_LiteLlmAddInFile Include="$(MSBuildThisFileDirectory)..\..\src\MeisterDev.Ai.Providers.LiteLlmAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_BedrockAddInFile Include="$(MSBuildThisFileDirectory)..\..\src\MeisterDev.Ai.Providers.BedrockAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_AzureOpenAiAddInFile Include="$(MSBuildThisFileDirectory)..\..\src\MeisterDev.Ai.Providers.AzureOpenAiAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_OpenAiAddInFile Include="$(MSBuildThisFileDirectory)..\..\src\MeisterDev.Ai.Providers.OpenAiAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_AnthropicAddInFile Include="$(MSBuildThisFileDirectory)..\..\src\MeisterDev.Ai.Providers.AnthropicAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(_GoogleVertexAddInFile)"
              DestinationFiles="@(_GoogleVertexAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.GoogleVertexAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_OpenAiCompatibleAddInFile)"
              DestinationFiles="@(_OpenAiCompatibleAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_LiteLlmAddInFile)"
              DestinationFiles="@(_LiteLlmAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.LiteLlmAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_BedrockAddInFile)"
              DestinationFiles="@(_BedrockAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.BedrockAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_AzureOpenAiAddInFile)"
              DestinationFiles="@(_AzureOpenAiAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.AzureOpenAiAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_OpenAiAddInFile)"
              DestinationFiles="@(_OpenAiAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.OpenAiAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_AnthropicAddInFile)"
              DestinationFiles="@(_AnthropicAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.AnthropicAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
    </Target>

</Project>
