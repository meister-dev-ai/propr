<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The shared add-in build configuration, imported by path because this add-in is in the same repository as
        the contract. An add-in built elsewhere takes the contract as a package and NuGet imports the same two
        files for it.
    -->
    <Import Project="..\..\src\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>MeisterDev.Ai.Providers.ExampleAddIn</RootNamespace>
    </PropertyGroup>

    <!--
        A provider family built the way one built outside this repository is built: the contract assembly and
        nothing else from here. It exists so the contract is exercised from the position an add-in author is in,
        where a type the contract does not carry is a compile error rather than a using directive away. It ships
        nowhere and is registered nowhere; the seven families the product ships still live in the shared runtime.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.Abstractions\MeisterDev.Ai.Providers.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)"/>
    </ItemGroup>

    <Import Project="..\..\src\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.targets"/>

</Project>
