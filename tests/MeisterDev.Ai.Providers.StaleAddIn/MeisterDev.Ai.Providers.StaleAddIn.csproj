<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The shared add-in build configuration, imported by path because this add-in is in the same repository as
        the contract, exactly as the example add-in imports it.
    -->
    <Import Project="..\..\src\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>MeisterDev.Ai.Providers.StaleAddIn</RootNamespace>
    </PropertyGroup>

    <!--
        A second add-in, built the same way as the example one, that declares a contract version the host does
        not carry. It exists so the loader's version check is exercised against a real assembly rather than a
        stand-in: the check reads a value the family states about itself, and a family that states a value the
        host accepts is not evidence that one stating another is refused. Having two add-ins is also what shows
        that a refused one leaves the other loaded.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\MeisterDev.Ai.Providers.Abstractions\MeisterDev.Ai.Providers.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)"/>
    </ItemGroup>

    <Import Project="..\..\src\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.targets"/>

</Project>
