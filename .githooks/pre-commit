#!/bin/sh
# pre-commit hook: enforces format, build, and test checks before every commit.
#
# Install once per clone:
#   git config core.hooksPath .githooks
# Or run: bash scripts/setup-hooks.sh / scripts/setup-hooks.ps1
set -eu

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
STAGED_FRONTEND_FILES=$(printf '%s\n' "$STAGED_FILES" | grep '^frontend/' || true)

# format_changed.py selects the files ReSharper formats in the solution, and scans all of them when the
# formatting settings change. The hook only needs to know whether it has anything to check.
STAGED_FORMAT_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -v '^frontend/' | grep -E '\.(cs|props|targets|resx|xaml|xml|config)$|(^|/)\.editorconfig$|\.DotSettings$' || true)

# Build and test are gated on the files that can change what the solution compiles to.
STAGED_BACKEND_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.(cs|props|targets|csproj|slnx)$' || true)

if [ -z "$STAGED_FORMAT_FILES" ] && [ -z "$STAGED_BACKEND_FILES" ] && [ -z "$STAGED_FRONTEND_FILES" ]; then
    exit 0
fi

# The backend check builds and tests the whole solution and the frontend check type-checks and tests the whole
# frontend, so the result of each depends on the staged tree and not on the staged diff. A commit whose staged tree
# passed one of these checks in an earlier commit skips that check: the squash of a reviewed branch has the tree of
# the branch head, whose commit ran it. The format check reads only the staged files and always runs. The record
# lives in the git directory, is shared by the worktrees of the clone and keeps its last 500 entries. An entry counts
# for seven days, because the checks also read ignored files such as build outputs and installed packages, which the
# tree does not hold.
VERIFIED_TREES="$(git rev-parse --path-format=absolute --git-common-dir)/pre-commit-verified-trees"
TREE=$(git write-tree)
NOW=$(date +%s)

# verified CHECK: whether the staged tree passed CHECK in a commit of the last seven days.
verified() {
    [ -f "$VERIFIED_TREES" ] &&
        awk -v tree="$TREE" -v check="$1" -v since=$((NOW - 604800)) \
            '$1 == tree && $2 == check && $3 >= since { found = 1 } END { exit !found }' "$VERIFIED_TREES"
}

if [ -n "$STAGED_BACKEND_FILES" ] && verified backend; then
    echo "pre-commit: the staged tree passed the backend build and tests in an earlier commit; they do not run again."
    STAGED_BACKEND_FILES=
fi

if [ -n "$STAGED_FRONTEND_FILES" ] && verified frontend; then
    echo "pre-commit: the staged tree passed the frontend type-check and tests in an earlier commit; they do not run again."
    STAGED_FRONTEND_FILES=
fi

# The build and the tests read the working tree, so a passed check vouches for the staged tree only when the working
# tree holds nothing beyond the index: no unstaged change and no untracked file.
if git diff --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    RECORD_TREE=yes
else
    RECORD_TREE=no
fi

# MSBuild otherwise keeps its worker nodes alive after the build. Repeated hook runs then leave dozens of idle
# nodes behind, and together they fill the memory of the machine.
export MSBUILDDISABLENODEREUSE=1

# The format, backend and frontend checks read separate inputs, so they run at the same time. Each writes to
# its own log, and the logs are printed in a fixed order once all checks have finished. If formatting changes
# a file, the commit fails, and all checks run again after the formatted file is staged.
CHECK_DIR=$(mktemp -d)
trap 'rm -rf "$CHECK_DIR"' EXIT

if [ -n "$STAGED_FORMAT_FILES" ]; then
    echo "pre-commit: checking source formatting..."
    python3 scripts/format_changed.py --staged > "$CHECK_DIR/format.log" 2>&1 &
    FORMAT_PID=$!
fi

if [ -n "$STAGED_BACKEND_FILES" ]; then
    echo "pre-commit: running dotnet build and dotnet test..."
    (
        dotnet build ./MeisterDev.ProPR.slnx --configuration Release --nologo -consoleLoggerParameters:NoSummary \
            || { echo "pre-commit: FAILED -- build errors detected."; exit 1; }
        # At quiet verbosity, dotnet test names a failed test but omits its message and stack trace. The console
        # logger at minimal verbosity adds them and still prints only a summary for passing tests.
        dotnet test ./MeisterDev.ProPR.slnx --no-build --no-restore --configuration Release --nologo --verbosity quiet \
            --logger "console;verbosity=minimal" \
            || { echo "pre-commit: FAILED -- one or more backend tests failed."; exit 1; }
    ) > "$CHECK_DIR/backend.log" 2>&1 &
    BACKEND_PID=$!
fi

if [ -n "$STAGED_FRONTEND_FILES" ]; then
    echo "pre-commit: running frontend type-check and tests..."
    (
        cd frontend
        npm run type-check || { echo "pre-commit: FAILED -- frontend type-check errors detected."; exit 1; }
        npm run test || { echo "pre-commit: FAILED -- one or more frontend tests failed."; exit 1; }
    ) > "$CHECK_DIR/frontend.log" 2>&1 &
    FRONTEND_PID=$!
fi

CHECK_FAILED=0

# report NAME PID LOG: waits for one check, prints its log and records whether it failed.
report() {
    if wait "$2"; then
        cat "$3"
        echo "pre-commit: $1 passed."
    else
        cat "$3"
        echo "pre-commit: FAILED -- $1."
        CHECK_FAILED=1
    fi
}

if [ -n "$STAGED_FORMAT_FILES" ]; then
    report "format check" "$FORMAT_PID" "$CHECK_DIR/format.log"
fi

if [ -n "$STAGED_BACKEND_FILES" ]; then
    report "backend build and tests" "$BACKEND_PID" "$CHECK_DIR/backend.log"
fi

if [ -n "$STAGED_FRONTEND_FILES" ]; then
    report "frontend type-check and tests" "$FRONTEND_PID" "$CHECK_DIR/frontend.log"
fi

if [ "$CHECK_FAILED" -eq 0 ] && [ "$RECORD_TREE" = yes ]; then
    {
        cat "$VERIFIED_TREES" 2>/dev/null || true
        if [ -n "$STAGED_BACKEND_FILES" ]; then printf '%s backend %s\n' "$TREE" "$NOW"; fi
        if [ -n "$STAGED_FRONTEND_FILES" ]; then printf '%s frontend %s\n' "$TREE" "$NOW"; fi
    } | tail -n 500 > "$CHECK_DIR/verified-trees"
    mv "$CHECK_DIR/verified-trees" "$VERIFIED_TREES"
fi

exit "$CHECK_FAILED"
