<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The boundary of the Code Insights feature: the ports other layers call and the records those ports
      exchange. Kept in its own project so the review pipeline can notify the feature without depending on
      it, which is what keeps the dependency pointing one way.
    -->
    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.ProPR.Domain\MeisterDev.ProPR.Domain.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

</Project>
