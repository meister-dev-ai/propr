<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <RootNamespace>MeisterDev.Ai.Providers</RootNamespace>
    </PropertyGroup>

    <!--
        This library implements provider communication and nothing else. Two rules keep it separable from the
        product that hosts it: it must never take a ProjectReference on a MeisterDev.ProPR.* project, and no file
        in it may carry the commercial-only notice. Dependencies stay limited to Microsoft.Extensions.AI and the
        provider SDKs beneath it.
    -->
    <!--
        The catalog snapshot is embedded rather than fetched, so the application populates its model catalog
        without ever egressing to the snapshot host. Attribution for it lives in NOTICE at the repository root.
    -->
    <ItemGroup>
        <EmbeddedResource Include="Catalog\Snapshot\models.dev.json"/>
    </ItemGroup>

    <!--
        The contract every driver is written against. It is a separate assembly so a provider family built
        outside this repository can reference the driver contract without taking the decorator stages, the
        guarded egress handler, the secret envelope, the catalog or any vendor SDK with it.
    -->
    <!--
        The driver checks. The loader runs them against every add-in it takes, so a family that cannot satisfy
        them is skipped with the check named instead of serving reviews. The kit references the contract and
        nothing else, so taking it here adds nothing to what this library already carries.
    -->
    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.Abstractions\MeisterDev.Ai.Providers.Abstractions.csproj"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.Conformance\MeisterDev.Ai.Providers.Conformance.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI" Version="$(MicrosoftExtensionsAIVersion)"/>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12"/>

        <!--
            Reads an add-in's assembly attributes without executing any of it. A discovery pass runs before an
            administrator has activated anything, so it maps the file for reflection rather than loading it.
        -->
        <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0"/>
    </ItemGroup>

</Project>
