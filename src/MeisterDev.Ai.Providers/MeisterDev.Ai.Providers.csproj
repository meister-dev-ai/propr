<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <RootNamespace>MeisterDev.Ai.Providers</RootNamespace>
    </PropertyGroup>

    <!--
        This library owns the "talk to a model provider" concern and is intentionally self-contained: it must
        never take a ProjectReference on any MeisterDev.ProPR.* project, and no file in it may carry the
        commercial-only notice. Those two rules are what keep it separable from the product that hosts it.
        Dependencies are limited to Microsoft.Extensions.AI and the provider SDKs behind it.
    -->

</Project>
