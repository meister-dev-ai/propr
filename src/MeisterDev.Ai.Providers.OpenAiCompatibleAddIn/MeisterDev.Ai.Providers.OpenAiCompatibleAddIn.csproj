<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The shared add-in build configuration, imported by path because this add-in is in the same repository as
        the contract. An add-in built elsewhere takes the contract as a package and NuGet imports the same two
        files for it. The three settings they carry keep the contract, the model abstractions and the
        conformance kit out of this project's output folder, which is what the loader requires of a folder it
        reads.
    -->
    <Import Project="..\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <RootNamespace>MeisterDev.Ai.Providers.OpenAiCompatibleAddIn</RootNamespace>
    </PropertyGroup>

    <!--
        Any endpoint serving the OpenAI wire protocol, built the way a family outside this repository is built:
        the contract assembly and this family's own vendor dependency, and nothing from the host or from the
        shared provider runtime. The OpenAI client library arrives with the Microsoft.Extensions.AI adapter for
        it, which is what turns that library's clients into the abstractions the contract is written in.
    -->
    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.Abstractions\MeisterDev.Ai.Providers.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="$(MicrosoftExtensionsAIVersion)"/>
    </ItemGroup>

    <Import Project="..\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.targets"/>

</Project>
