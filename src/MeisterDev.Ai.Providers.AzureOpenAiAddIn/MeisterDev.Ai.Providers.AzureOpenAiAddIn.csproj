<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The shared add-in build configuration, imported by path because this add-in is in the same repository as
        the contract. An add-in built elsewhere takes the contract as a package and NuGet imports the same two
        files for it. The three settings they carry keep the contract, the model abstractions and the
        conformance kit out of this project's output folder, which is what the loader requires of a folder it
        reads.
    -->
    <Import Project="..\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <RootNamespace>MeisterDev.Ai.Providers.AzureOpenAiAddIn</RootNamespace>
        <!-- OPENAI001: the Responses API is still marked for evaluation only, and is used deliberately for
             reasoning and tool use. Without this the call site is an error, not a warning. Revisit when the
             API stabilises. -->
        <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    </PropertyGroup>

    <!--
        Azure OpenAI and Azure AI Foundry, built the way a family outside this repository is built: the contract
        assembly and this family's own vendor dependencies, and nothing from the host or from the shared provider
        runtime. The resource is reached at its OpenAI-compatible surface with the OpenAI client library, so that
        library and the Azure credential chain the managed-identity mode mints tokens from are what this family
        carries. Azure.Identity is referenced here and no longer by the shared provider project.
    -->
    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.Abstractions\MeisterDev.Ai.Providers.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.19.0"/>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="$(MicrosoftExtensionsAIVersion)"/>
    </ItemGroup>

    <Import Project="..\MeisterDev.Ai.Providers.Abstractions\build\MeisterDev.Ai.Providers.Abstractions.targets"/>

</Project>
