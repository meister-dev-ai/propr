<Project Sdk="Microsoft.NET.Sdk.Web">

    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.ProPR.Web\MeisterDev.ProPR.Web.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.CodeInsights\MeisterDev.ProPR.CodeInsights.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.CodeInsights.Contracts\MeisterDev.ProPR.CodeInsights.Contracts.csproj"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers\MeisterDev.Ai.Providers.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.Application\MeisterDev.ProPR.Application.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.Infrastructure\MeisterDev.ProPR.Infrastructure.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.Observability\MeisterDev.ProPR.Observability.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.ProCursor.Contracts\MeisterDev.ProPR.ProCursor.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7"/>
        <PackageReference Include="Microsoft.OpenApi" Version="2.7.5"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3"/>
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.0-beta.1"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.13.0"/>
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
        <PackageReference Include="Serilog.Sinks.Grafana.Loki" Version="8.3.2"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <UserSecretsId>1d530dec-7d4c-4cce-a315-1bb4d0e0ea7e</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MeisterDev.ProPR.Api.Tests"/>
    </ItemGroup>

    <!--
        The provider families this build ships as add-ins. They are referenced so they are built first and never
        compiled against: the host resolves them from the built-in directory at startup, which is the same route
        a family supplied by anyone else takes.
    -->
    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.GoogleVertexAddIn\MeisterDev.Ai.Providers.GoogleVertexAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.LiteLlmAddIn\MeisterDev.Ai.Providers.LiteLlmAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.BedrockAddIn\MeisterDev.Ai.Providers.BedrockAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.AzureOpenAiAddIn\MeisterDev.Ai.Providers.AzureOpenAiAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.OpenAiAddIn\MeisterDev.Ai.Providers.OpenAiAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers.AnthropicAddIn\MeisterDev.Ai.Providers.AnthropicAddIn.csproj"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
        Puts each shipped add-in in the built-in directory, a folder per family named after the assembly in it,
        so a build run from here holds the same layout the image does. The item groups sit inside the target so
        they are expanded after the referenced projects have been built.
    -->
    <Target Name="StageBuiltInProviderAddIns" AfterTargets="Build">
        <ItemGroup>
            <_GoogleVertexAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.GoogleVertexAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_OpenAiCompatibleAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_LiteLlmAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.LiteLlmAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_BedrockAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.BedrockAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_AzureOpenAiAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.AzureOpenAiAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_OpenAiAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.OpenAiAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
            <_AnthropicAddInFile Include="$(MSBuildThisFileDirectory)..\MeisterDev.Ai.Providers.AnthropicAddIn\bin\$(Configuration)\$(TargetFramework)\**\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(_GoogleVertexAddInFile)"
              DestinationFiles="@(_GoogleVertexAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.GoogleVertexAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_OpenAiCompatibleAddInFile)"
              DestinationFiles="@(_OpenAiCompatibleAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.OpenAiCompatibleAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_LiteLlmAddInFile)"
              DestinationFiles="@(_LiteLlmAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.LiteLlmAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_BedrockAddInFile)"
              DestinationFiles="@(_BedrockAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.BedrockAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_AzureOpenAiAddInFile)"
              DestinationFiles="@(_AzureOpenAiAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.AzureOpenAiAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_OpenAiAddInFile)"
              DestinationFiles="@(_OpenAiAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.OpenAiAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(_AnthropicAddInFile)"
              DestinationFiles="@(_AnthropicAddInFile->'$(OutDir)provider-add-ins\MeisterDev.Ai.Providers.AnthropicAddIn\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
    </Target>

</Project>
