<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\MeisterDev.ProPR.CodeInsights.Contracts\MeisterDev.ProPR.CodeInsights.Contracts.csproj"/>
        <ProjectReference Include="..\MeisterDev.Ai.Providers\MeisterDev.Ai.Providers.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.Domain\MeisterDev.ProPR.Domain.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.CodeAnalysis\MeisterDev.ProPR.CodeAnalysis.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.ProCursor.Contracts\MeisterDev.ProPR.ProCursor.Contracts.csproj"/>
        <ProjectReference Include="..\MeisterDev.ProPR.Runner.Contracts\MeisterDev.ProPR.Runner.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.1"/>
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.7"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7"/>
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.7"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <!-- Removed suppression of CS1591; will add XML comments to public APIs. -->
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>MeisterDev.ProPR.Application.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!--
        Where anonymous usage statistics are posted, fixed when this assembly is compiled.

        Empty on a normal build, which means the production receiver. A local or staging image is built with
        `-p:UsageStatisticsEndpoint=http://host:port/v1/ping`, and what that image sends to is then a property
        of the image rather than of its environment: no variable can redirect a running installation, and none
        can silence one either. A value that is not an absolute http or https address stops the host at
        startup rather than falling back to production.
    -->
    <PropertyGroup>
        <UsageStatisticsEndpoint Condition="'$(UsageStatisticsEndpoint)' == ''"></UsageStatisticsEndpoint>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>UsageStatisticsEndpoint</_Parameter1>
            <_Parameter2>$(UsageStatisticsEndpoint)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
